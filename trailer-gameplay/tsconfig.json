{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "../src/engine/data/mapGeometry.ts",
    "../src/engine/data/nigeriaData.ts",
    "../src/engine/data/mapIds.ts",
    "../src/types/svg-maps.d.ts"
  ]
}