{
  "name": "i-heard-a-rumor-story-trailer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "vo": "node scripts/make-vo.mjs",
    "audio": "node scripts/make-mix.mjs",
    "stills": "node scripts/stills.mjs",
    "render:landscape": "remotion render src/index.ts Story-16x9 out/the-receipts-16x9.mp4 --port=3418 --concurrency=5",
    "render:portrait": "remotion render src/index.ts Story-9x16 out/the-receipts-9x16.mp4 --port=3418 --concurrency=5",
    "render:all": "npm run render:landscape && npm run render:portrait",
    "remux": "node scripts/remux.mjs",
    "selftest": "node scripts/vo-selftest.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@svg-maps/nigeria": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}