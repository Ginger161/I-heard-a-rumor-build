{
  "name": "i-heard-a-rumor-build",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify": "esbuild scripts/verify.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify.cjs --log-level=warning && node node_modules/.cache/verify.cjs",
    "simulate": "esbuild scripts/simulate.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/simulate.cjs --log-level=warning && node node_modules/.cache/simulate.cjs",
    "rate": "esbuild scripts/rate.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/rate.cjs --log-level=warning && node node_modules/.cache/rate.cjs",
    "simulate:story": "esbuild scripts/storySim.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/storysim.cjs --log-level=warning && node node_modules/.cache/storysim.cjs",
    "build:studio": "tsc --noEmit && vite build --mode studio --outDir dist-studio",
    "egg:hash": "node scripts/eggHash.mjs",
    "build:offline": "npm run build && node scripts/singleFile.mjs",
    "avatars": "esbuild scripts/avatarSheet.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=node_modules/.cache/avatars.cjs --log-level=error && node node_modules/.cache/avatars.cjs",
    "spread": "esbuild scripts/spread.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/spread.cjs --log-level=warning && node node_modules/.cache/spread.cjs",
    "doc:difficulty": "esbuild scripts/difficultyDoc.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/difficultyDoc.cjs --log-level=error && node node_modules/.cache/difficultyDoc.cjs",
    "strategies": "esbuild scripts/strategies.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/strategies.cjs --log-level=error && node node_modules/.cache/strategies.cjs",
    "tune:styles": "esbuild scripts/tune2.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/tune2.cjs --log-level=error && node node_modules/.cache/tune2.cjs",
    "calibrate": "esbuild scripts/calibrate30.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/calibrate30.cjs --log-level=error && node node_modules/.cache/calibrate30.cjs"
  },
  "dependencies": {
    "@svg-maps/nigeria": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "author": "Ginger-Eke Chienyegom",
  "license": "UNLICENSED",
  "private": true
}
